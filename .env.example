# ============================================================
# Supabase — من إعدادات المشروع في supabase.com > Project Settings > API
# ============================================================

# رابط المشروع، مثال: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key — آمن للاستخدام في المتصفح (يُحترم دائماً عبر RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key — سري تماماً، يُستخدم فقط داخل Server-side API routes
# لا يجب أبداً أن يصل هذا المفتاح إلى الـ frontend أو أي كود يعمل في المتصفح.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# جلسة العضو (Member Session)
# ============================================================
# سلسلة عشوائية طويلة تُستخدم لتوقيع كوكي جلسة العضو بعد أول تسجيل.
# ولّدها بالأمر: openssl rand -base64 32
SESSION_SECRET=

# ============================================================
# عام
# ============================================================
# رابط الموقع بعد النشر (يُستخدم لبناء رابط QR الكامل في لوحة التحكم)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
